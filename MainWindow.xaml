<Window x:Class="WindowSnapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WindowSnapper" Width="940" Height="955" MinWidth="820" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource PanelBrush}"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="MainWindowFrame" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="WindowSnapper | by Lumisere" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="MaximizeButton" FontSize="20" Style="{StaticResource TitleBarButton}" Click="MaximizeRestore_Click" ToolTip="Maximize">
                            <TextBlock Text="□" Margin="0,-5,0,0"/>
                        </Button>
                        <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="334*" />
                    <RowDefinition Height="471*"/>
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Padding="0,0,0,18" Grid.RowSpan="2">
                    <Grid Margin="2,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- TARGET -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="Find window by" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <ComboBox x:Name="TargetModeCombo" DisplayMemberPath="Label" SelectionChanged="TargetModeCombo_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Grid.ColumnSpan="3">
                                <TextBlock x:Name="TargetValueLabel" Text="Process / EXE name" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox x:Name="TargetValueBox" TextChanged="TargetValueBox_TextChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Open window" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <ComboBox x:Name="OpenWindowsCombo" DisplayMemberPath="Display" MinWidth="360" SelectionChanged="OpenWindowsCombo_SelectionChanged" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Refresh" Click="RefreshWindows_Click" VerticalAlignment="Bottom" />
                            <Button Grid.Column="4" Content="Use window" Click="UseSelectedWindow_Click" VerticalAlignment="Bottom" />
                        </Grid>

                        <Border Grid.Row="5" Background="#0E1014" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,7" VerticalAlignment="Bottom">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" x:Name="TargetStatusText" Text="No target selected" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- CAPTURE -->
                        <Grid Grid.Row="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Capture" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Screenshot every (minutes)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox x:Name="IntervalBox" Text="5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Image format" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <ComboBox x:Name="FormatCombo" DisplayMemberPath="Label" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Capture method" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <ComboBox x:Name="BackendCombo" DisplayMemberPath="Label" SelectionChanged="BackendCombo_SelectionChanged" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="11" x:Name="BackendHelpText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,0" />

                        <!-- OUTPUT -->
                        <Grid Grid.Row="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="File name prefix" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox x:Name="PrefixBox" Text="capture" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Save screenshots to" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox x:Name="FolderBox" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="Browse…" Click="Browse_Click" VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- NOTIFICATION -->
                        <Grid Grid.Row="17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notification" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="19" Grid.RowSpan="3" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Notification mode" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NotificationModeHelpText"
                                                   Text="Choose when WindowSnapper should notify you."
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10.5" />
                                </StackPanel>

                                <ComboBox x:Name="NotificationModeCombo"
                                              Grid.Column="2"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="NotificationModeCombo_SelectionChanged"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                            <Grid x:Name="ScreenshotNotificationPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Screenshot trigger" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Notify after a set number of successful captures."
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10.5" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                            Content="Test notification"
                                            Click="TestToast_Click"
                                            MinWidth="112"
                                            Padding="10,5"
                                            VerticalAlignment="Center" />

                                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Notify every" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox x:Name="ScreenshotToastEveryBox"
                                                 Grid.Column="1"
                                                 Text="1"
                                                 LostFocus="NotificationSettings_LostFocus" />
                                    <TextBlock Grid.Column="2"
                                                   Text="screenshots"
                                                   Margin="8,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="TimedNotificationPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Timer trigger" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Notify on its own timer, independent of screenshot timing."
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10.5" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                            Content="Test notification"
                                            Click="TestReminder_Click"
                                            MinWidth="112"
                                            Padding="10,5"
                                            VerticalAlignment="Center" />

                                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Notify every" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox x:Name="SoundIntervalBox"
                                                 Grid.Column="1"
                                                 Text="5"
                                                 LostFocus="NotificationSettings_LostFocus" />
                                    <TextBlock Grid.Column="2"
                                                   Text="minutes"
                                                   Margin="8,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Border Height="1" Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Notification sound" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NotificationSoundHelpText"
                                                   Text="Played together with the toast whenever the selected trigger fires."
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10.5" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="NotificationSoundToggle"
                                                      Style="{StaticResource SoundSwitchStyle}"
                                                      IsChecked="True"
                                                      Click="NotificationSoundToggle_Click"
                                                      Margin="0,0,8,0"
                                                      ToolTip="Turn notification audio on or off. Toasts are unaffected." />
                                    <Button x:Name="TestSoundButton"
                                                Content="Test sound"
                                                Click="TestSound_Click"
                                                MinWidth="88"
                                                Padding="10,5" />
                                </StackPanel>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="SoundPathBox"
                                                 Grid.Column="0"
                                                 Text="notif.mp3 (default)"
                                                 IsReadOnly="True"
                                                 ToolTip="Choose MP3, WAV, WMA, M4A/AAC, AIFF or FLAC audio." />
                                    <Button Grid.Column="2" Content="Choose…" Click="ChooseSound_Click" />
                                    <Button Grid.Column="4" Content="Default" Click="UseDefaultSound_Click" />
                                </Grid>
                            </Grid>

                            <Border Height="1" Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toast size" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    BorderBrush="#693039"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,2">
                                            <TextBlock x:Name="ToastScaleValueText"
                                                           Text="100%  ·  344 × 82"
                                                           Foreground="#F4C8CC"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Slider x:Name="ToastScaleSlider"
                                                Style="{StaticResource ToastSliderStyle}"
                                                Minimum="0.8"
                                                Maximum="2.0"
                                                Value="1.0"
                                                SmallChange="0.05"
                                                LargeChange="0.10"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="ToastScaleSlider_ValueChanged"
                                                PreviewMouseLeftButtonUp="NotificationSettings_LostFocus" />

                                    <Grid Margin="1,3,1,0">
                                        <TextBlock Text="80%" Foreground="{StaticResource MutedBrush}" FontSize="9.5" HorizontalAlignment="Left" />
                                        <TextBlock Text="200%" Foreground="{StaticResource MutedBrush}" FontSize="9.5" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="2,12,2,0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BorderBrush}" />
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CaptureStatusText" Text="Idle" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Open folder" Click="OpenFolder_Click" Margin="0,0,8,0" />
                            <Button Content="Capture once" Click="CaptureOnceClick" Margin="0,0,8,0" />
                            <Button x:Name="StartStopButton" Content="Start capture" Style="{StaticResource PrimaryButton}" Click="StartStopClick" MinWidth="108" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
